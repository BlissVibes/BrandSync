# API base URL — defaults to /api (proxied by Vite dev server)
# For GitHub Pages static deploy: set to your deployed backend URL
# For local dev: leave empty (Vite proxy handles it)
# VITE_API_URL=https://your-backend.vercel.app/api

# GitHub Pages base URL (set to your repo path)
# VITE_BASE_URL=/BrandSync/
